# Server-side configuration. Never put these values in src/ or VITE_* variables.
PORT=18787
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible Messages API endpoint.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5-5
TRANSCRIPTION_PROVIDER=volcengine

# Optional online B-roll search. Keys are server-side only.
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENCHATCUT_MCP_URL=http://127.0.0.1:5199/api/external-mcp/mcp
# Optional override; the probe otherwise reads ~/.openchatcut/mcp-token locally.
OPENCHATCUT_MCP_TOKEN=

# Volcengine / Doubao ASR primary. Standard mode matches the official task-submission doc.
VOLCENGINE_ASR_MODE=standard
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_ASR_CLUSTER=
VOLCENGINE_ASR_PUBLIC_BASE_URL=https://your-public-domain.example
# Optional fast API mode: set VOLCENGINE_ASR_MODE=fast and fill this key instead.
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.auc
VOLCENGINE_ASR_BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_ASR_MODEL=bigmodel

# Tencent Cloud ASR fallback (TC3 credentials)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_ASR_ENDPOINT=asr.tencentcloudapi.com
TENCENTCLOUD_ASR_ENGINE_MODEL_TYPE=16k_zh

# Local CPU-only second-pass proofreading; binaries/models stay under ignored portal/storage.
WAYNE_WHISPER_CLI_PATH=
WAYNE_WHISPER_MODEL_PATH=
WAYNE_WHISPER_THREADS=8
WAYNE_WHISPER_TIMEOUT_MS=1800000

# Reference-video style transfer is off by default.
REFERENCE_STYLE_ENABLED=0
# Cumulative rollout: admin | preview | single | multi
REFERENCE_STYLE_STAGE=admin
# Optional Claude vision pass for reference shot/layout/caption analysis.
REFERENCE_STYLE_VISUAL_ANALYSIS=1
REFERENCE_ANALYSIS_MODEL=
REFERENCE_ANALYSIS_TIMEOUT_MS=120000
# Conservative local BPM/onset analysis from the extracted mono track.
REFERENCE_STYLE_AUDIO_ANALYSIS=1
WAYNE_AUDIO_ANALYSIS_PYTHON=python3
WAYNE_STYLE_DIR=
WAYNE_STYLE_AGENT=claude-code
WAYNE_STYLE_CLAUDE_AUTH=oauth
WAYNE_FACE_DETECTOR_PYTHON=python3
# Optional fixed Chromium path for StyleProject rendering.
REMOTION_BROWSER_EXECUTABLE=
