{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayne.local/contracts/style-spec.v2.schema.json",
  "title": "StyleSpec.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "canvas", "title", "identity", "captions", "effects"],
  "properties": {
    "contract": { "const": "style-spec.v2" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "title": { "$ref": "#/$defs/title" },
    "identity": { "$ref": "#/$defs/identity" },
    "captions": { "$ref": "#/$defs/captions" },
    "effects": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/effect" }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "anchor": {
      "enum": [
        "top_left", "top_center", "top_right",
        "middle_left", "middle_center", "middle_right",
        "bottom_left", "bottom_center", "bottom_right"
      ]
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "color", "opacity", "radiusRatio", "paddingXRatio", "paddingYRatio", "blurPx"],
      "properties": {
        "enabled": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "radiusRatio": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "paddingXRatio": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "paddingYRatio": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "blurPx": { "type": "number", "minimum": 0, "maximum": 40 }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "fontWeight", "fontSizeRatio", "lineHeight", "letterSpacingRatio", "color", "strokeColor", "strokeWidthRatio", "shadowOpacity", "shadowBlurRatio", "shadowOffsetYRatio"],
      "properties": {
        "fontFamily": { "enum": ["sans", "serif", "display", "rounded"] },
        "fontWeight": { "type": "integer", "minimum": 300, "maximum": 900 },
        "fontSizeRatio": { "type": "number", "minimum": 0.01, "maximum": 0.2 },
        "lineHeight": { "type": "number", "minimum": 0.8, "maximum": 2 },
        "letterSpacingRatio": { "type": "number", "minimum": -0.02, "maximum": 0.1 },
        "color": { "$ref": "#/$defs/color" },
        "strokeColor": { "$ref": "#/$defs/color" },
        "strokeWidthRatio": { "type": "number", "minimum": 0, "maximum": 0.02 },
        "shadowOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "shadowBlurRatio": { "type": "number", "minimum": 0, "maximum": 0.05 },
        "shadowOffsetYRatio": { "type": "number", "minimum": -0.05, "maximum": 0.05 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationMs", "delayMs", "easing", "scaleFrom", "translateYRatio", "stagger", "staggerMs"],
      "properties": {
        "type": { "enum": ["none", "fade", "scale", "fade-scale", "slide-up", "wipe"] },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 1200 },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 1200 },
        "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out", "spring"] },
        "scaleFrom": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "translateYRatio": { "type": "number", "minimum": -0.2, "maximum": 0.2 },
        "stagger": { "enum": ["none", "word", "char"] },
        "staggerMs": { "type": "integer", "minimum": 0, "maximum": 300 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enter", "exit"],
      "properties": {
        "enter": { "$ref": "#/$defs/animation" },
        "exit": { "$ref": "#/$defs/animation" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectRatio", "safeArea"],
      "properties": {
        "aspectRatio": { "enum": ["9:16", "16:9"] },
        "safeArea": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topRatio", "rightRatio", "bottomRatio", "leftRatio"],
          "properties": {
            "topRatio": { "type": "number", "minimum": 0, "maximum": 0.3 },
            "rightRatio": { "type": "number", "minimum": 0, "maximum": 0.3 },
            "bottomRatio": { "type": "number", "minimum": 0, "maximum": 0.3 },
            "leftRatio": { "type": "number", "minimum": 0, "maximum": 0.3 }
          }
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "widthRatio", "maxLines", "panel", "primary", "secondary", "motion"],
      "properties": {
        "anchor": { "enum": ["top_left", "top_center", "top_right"] },
        "widthRatio": { "type": "number", "minimum": 0.2, "maximum": 1 },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 3 },
        "panel": { "$ref": "#/$defs/panel" },
        "primary": { "$ref": "#/$defs/typography" },
        "secondary": { "$ref": "#/$defs/typography" },
        "motion": { "$ref": "#/$defs/motion" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "maxWidthRatio", "panel", "primary", "secondary", "motion"],
      "properties": {
        "anchor": { "$ref": "#/$defs/anchor" },
        "maxWidthRatio": { "type": "number", "minimum": 0.2, "maximum": 0.8 },
        "panel": { "$ref": "#/$defs/panel" },
        "primary": { "$ref": "#/$defs/typography" },
        "secondary": { "$ref": "#/$defs/typography" },
        "motion": { "$ref": "#/$defs/motion" }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grouping", "maxCharsPerCue", "anchor", "maxWidthRatio", "panel", "typography", "highlight", "motion"],
      "properties": {
        "grouping": { "enum": ["word", "phrase", "sentence"] },
        "maxCharsPerCue": { "type": "integer", "minimum": 1, "maximum": 24 },
        "anchor": { "enum": ["top_center", "middle_center", "bottom_center"] },
        "maxWidthRatio": { "type": "number", "minimum": 0.3, "maximum": 1 },
        "panel": { "$ref": "#/$defs/panel" },
        "typography": { "$ref": "#/$defs/typography" },
        "highlight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "color", "strokeColor", "scalePeak", "durationMs"],
          "properties": {
            "strategy": { "enum": ["none", "keyword"] },
            "color": { "$ref": "#/$defs/color" },
            "strokeColor": { "$ref": "#/$defs/color" },
            "scalePeak": { "type": "number", "minimum": 1, "maximum": 1.3 },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 500 }
          }
        },
        "motion": { "$ref": "#/$defs/motion" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "trigger", "type", "durationMs", "delayMs", "easing", "intensity"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "target": { "enum": ["title", "identity", "captions", "overlay"] },
        "trigger": { "enum": ["enter", "cue_enter", "keyword", "exit"] },
        "type": { "enum": ["fade", "scale", "slide", "highlight", "color"] },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 1200 },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 1200 },
        "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out", "spring"] },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
